{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=ShopProject1;Username=postgres;Password=1234"
  },

  "JwtSettings": {
    "Issuer": "MyShopProjectBackend",
    "Audience": "MyShopProjectFron",
    "SecretKey": "superSecretKey1234567890!@#$%^&*()_+QWERTY"
  },
  "NLog": {
    "autoReload": true,

    "throwConfigExceptions": true,

    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "E:\\MyProjects\\Logs\\${logger}.log",
        "layout": "${longdate} ${level:uppercase=true} ${logger} ${message} ${exception}"

      },
      "logconsole": {
        "type": "Console"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole,logfile"
      }
    ]
  }


}
